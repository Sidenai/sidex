{
  "name": "sidex",
  "version": "0.1.3",
  "packageManager": "bun@1.3.14",
  "private": true,
  "description": "VS Code's workbench ported to Tauri (Rust backend + OS-native webview).",
  "keywords": ["editor", "ide", "tauri", "vscode", "webview"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sidenai/sidex.git"
  },
  "homepage": "https://github.com/sidenai/sidex#readme",
  "type": "module",
  "workspaces": ["apps/*", "packages/*", "infrastructure/*"],
  "scripts": {
    "prepare": "lefthook install || true",
    "setup": "bun run packages/build/src/extension-meta/cli.ts",
    "setup:full": "bash scripts/setup-extensions.sh && bun run packages/build/src/extension-meta/cli.ts",
    "build:wasm": "bun run packages/build/src/wasm/build.ts",
    "build:wasm:test": "bun run packages/build/src/wasm/build-test-fixture.ts",
    "dev": "bun run setup && bun run build:wasm -- --optional && node --max-old-space-size=8192 node_modules/vite/bin/vite.js --config apps/workbench/vite.config.ts",
    "build": "bun run setup && bun run build:wasm && node --max-old-space-size=12288 node_modules/vite/bin/vite.js build --config apps/workbench/vite.config.ts",
    "postbuild": "bun run packages/build/src/postbuild/cli.ts",
    "parity:check": "bun packages/build/src/parity/cli.ts check",
    "parity:gen": "bun packages/build/src/parity/cli.ts gen",
    "preview": "vite preview --config apps/workbench/vite.config.ts",
    "tauri": "tauri",
    "lint": "biome lint apps packages",
    "lint:fix": "biome lint --write apps packages",
    "format": "biome format --write apps packages",
    "format:check": "biome format apps packages",
    "rust:check": "cd apps/desktop && cargo check",
    "rust:clippy": "cd apps/desktop && cargo clippy --all-targets --all-features -- -D warnings",
    "rust:fmt": "cd apps/desktop && cargo fmt --all -- --check",
    "rust:fmt:fix": "cd apps/desktop && cargo fmt --all"
  },
  "overrides": {
    "@nevware21/ts-utils": "^0.16.0",
    "nanoid": "^3.3.20",
    "postcss": "^8.5.32",
    "sharp": "^0.35.5",
    "source-map-js": "^1.2.2"
  },
  "dependencies": {
    "@microsoft/1ds-core-js": "^4.4.3",
    "@microsoft/1ds-post-js": "^4.4.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-shell": "^2",
    "@vscode/codicons": "^0.0.45",
    "@vscode/iconv-lite-umd": "^0.7.1",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-image": "^0.9.0",
    "@xterm/addon-ligatures": "^0.10.0",
    "@xterm/addon-progress": "^0.2.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^5.5.0",
    "tas-client": "^0.4.1",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@taplo/cli": "0.7.0",
    "@tauri-apps/cli": "^2.11.4",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@types/bun": "1.3.14",
    "@types/katex": "^0.16.8",
    "@types/trusted-types": "^2.0.7",
    "@webgpu/types": "^0.1.71",
    "@xterm/headless": "^6.0.0",
    "jschardet": "^3.1.4",
    "lefthook": "2.1.10",
    "typescript": "6.0.3",
    "vite": "7.3.7"
  }
}
