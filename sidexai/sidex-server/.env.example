# sidex-server — optional configuration.
#
# When you run SideX the desktop app starts this server for you on loopback
# with SIDEX_NO_AUTH=1 and passes your provider credentials through the
# environment. Nothing here needs setting for that path to work.
#
# These variables matter when you run the server yourself.

# ── Server ───────────────────────────────────────────────────────────────────
SIDEX_PORT=7433

# Bind address. Defaults to 127.0.0.1. The server executes shell commands and
# edits files for the agent, so only widen this if you understand the exposure
# and have put your own authentication in front of it.
# SIDEX_BIND_ADDR=127.0.0.1

# There's no authentication to toggle — every request is served as the local
# user regardless. This only disables plan and credit metering, since you're
# paying your own provider directly rather than being billed through this
# server. Leave it set to 1 unless you've built a billing layer on top.
SIDEX_NO_AUTH=1

# Required only if you set SIDEX_BIND_ADDR to something other than loopback.
# The server refuses to start on a non-loopback address otherwise — it
# executes shell commands, so it must not become reachable from the network
# without you explicitly saying so. There is no authentication to turn on
# instead; this only removes the refusal, so put your own in front of it.
# SIDEX_ALLOW_UNAUTHENTICATED=1

# Where local usage/spend tracking (usage.db) is stored. Defaults to
# ~/.sidex/data. Session, transcript, and memory state always live under
# ~/.sidex (or SIDEX_HOME, if you've set that) regardless of this var.
# SIDEX_DATA_DIR=

# ── Providers ────────────────────────────────────────────────────────────────
# Per-provider credentials, in the form the desktop app passes down:
#
#   SIDEX_PROVIDER_<PROVIDER>_KEY
#   SIDEX_PROVIDER_<PROVIDER>_BASE_URL
#   SIDEX_PROVIDER_<PROVIDER>_AUTH        "api_key" (default) or "oauth"
#
# A base URL with no key is valid for a loopback server such as Ollama.
#
# SIDEX_PROVIDER_ANTHROPIC_KEY=
# SIDEX_PROVIDER_OPENAI_KEY=
# SIDEX_PROVIDER_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Default model, and the fallback endpoint used when no provider matches.
# SIDEX_MODEL=anthropic/claude-sonnet-4.6
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Self-hosting leftovers (not part of the desktop app's path, all off unless set) ──
# None of these apply to running SideX as a local, single-user agent server —
# they're only here for anyone standing this server up as a shared, multi-user
# backend instead. Ignore this whole section otherwise.

# Analytics. No events are sent without a key.
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://us.i.posthog.com

# Postgres, for recording usage/billing events in a multi-user deployment.
# Local runs use SQLite under SIDEX_DATA_DIR and need none of this.
# SIDEX_DATABASE_URL=

# Code embeddings and vector search, for a hosted semantic index instead of
# on-device BM25.
# VOYAGE_API_KEY=
# TURBOPUFFER_API_KEY=
# COHERE_API_KEY=
